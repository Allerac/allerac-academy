{
  "name": "allerac-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Allerac Academy learning site (Cloudflare Worker with static assets).",
  "scripts": {
    "build:content": "node scripts/build-content.mjs",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply academy --local",
    "db:migrate:remote": "wrangler d1 migrations apply academy --remote",
    "typecheck": "npm run build:content && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/smoke.mjs && node test/e2e/i18n.mjs",
    "deploy": "wrangler d1 migrations apply academy --remote && wrangler deploy",
    "test:e2e:i18n": "node test/e2e/i18n.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "marked": "^18.0.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.50.0"
  }
}
