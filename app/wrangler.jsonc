{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allerac-academy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Parses content/ and tutor/ into src/generated/content.ts before dev and deploy.
  "build": {
    "command": "node scripts/build-content.mjs",
    "watch_dir": ["../content", "../tutor"]
  },

  // Static front end. API routes go to the Worker first; everything else is served from public/.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "routes": [{ "pattern": "academy.allerac.ai", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "academy",
      // TODO: replace with the id printed by `wrangler d1 create academy`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Allerac One base URL, e.g. https://one.allerac.ai (exposed via Cloudflare Tunnel). Empty = tutor unavailable.
    "ALLERAC_ONE_BASE_URL": "",
    // Allerac One unit (domain) that acts as the tutor. Empty = tutor unavailable.
    "ALLERAC_ONE_DOMAIN_SLUG": ""
  }
  // Secret (not in this file): BOT_API_KEY. Set with `wrangler secret put BOT_API_KEY`,
  // or in app/.dev.vars for local development.
}
